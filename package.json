{
  "name": "playwright-data-driven-starter",
  "version": "0.1.0",
  "description": "Data-driven Playwright and TypeScript starter with POM, audited locator recovery, Docker and GitHub Actions",
  "scripts": {
    "test": "playwright test",
    "setup": "bash scripts/setup.sh",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsc --outDir .build && node --test .build/tests/unit/*.test.js",
    "verify": "npm run typecheck && npm run test:unit && npm test",
    "test:headed": "playwright test --headed",
    "test:docker": "docker compose run --rm tests",
    "report": "playwright show-report",
    "test:strict": "cross-env LOCATOR_RECOVERY=off playwright test",
    "agent:index": "tsx scripts/agent/framework-index.ts index",
    "agent:find-test": "tsx scripts/agent/framework-index.ts find-test",
    "agent:find-method": "tsx scripts/agent/framework-index.ts find-method",
    "agent:coverage": "tsx scripts/agent/framework-index.ts coverage",
    "agent:check": "tsx scripts/agent/check-rules.ts",
    "agent:verify": "npm run typecheck && npm run agent:check && npm run test:unit && npm run test:strict"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "cross-env": "^10.1.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
